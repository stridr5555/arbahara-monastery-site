{
  "name": "haramonastery-site",
  "version": "1.0.0",
  "private": true,
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/update-translations.mjs --check && node scripts/verify-media.mjs && tsc --noEmit && vite build && node scripts/build-static.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "translations": "node scripts/update-translations.mjs",
    "translations:check": "node scripts/update-translations.mjs --check",
    "process:recordings": "node scripts/process-meeting-recordings.mjs",
    "sync:drive": "node scripts/sync-drive-recordings.mjs",
    "sync:drive:publish": "node scripts/sync-drive-recordings.mjs --commit"
  },
  "dependencies": {
    "@auth/core": "^0.41.3",
    "@convex-dev/auth": "^0.0.95",
    "@gsap/react": "^2.1.2",
    "convex": "^1.46.0",
    "exceljs": "^4.4.0",
    "gsap": "^3.15.0",
    "lucide-react": "^1.47.0",
    "nodemailer": "^10.0.10",
    "plaid": "^48.0.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-plaid-link": "^5.0.0",
    "stripe": "^22.6.2",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@babel/parser": "^8.0.6",
    "@babel/traverse": "^8.0.6",
    "@edge-runtime/vm": "^5.0.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "convex-test": "^0.0.59",
    "prettier": "^3.9.8",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
