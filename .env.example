VITE_CONVEX_URL=https://your-deployment.convex.cloud
# Configure server-only secrets through Convex/Vercel dashboards, never VITE_ variables.
# See docs/OPERATIONS.md for deployment, access, backups, and payment configuration.
# Server-only integration variables (set in the intended Convex environment):
# INTEGRATION_TOKEN_KEY: unique 32-byte random key encoded as 64 hexadecimal characters.
# CALENDAR_GOOGLE_CLIENT_ID, CALENDAR_GOOGLE_CLIENT_SECRET, CALENDAR_GOOGLE_REDIRECT_URI
# PLAID_CLIENT_ID, PLAID_SECRET, PLAID_ENV (sandbox or production), PLAID_REDIRECT_URI
# PLAID_REDIRECT_URI: exact HTTPS /members OAuth return URL registered in Plaid.
# BANK_DETAILS_PRIVATE_KEY: dedicated RSA PKCS8 PEM, at least 3072 bits.
# BANK_DETAILS_ENABLED=true enables encrypted setup requests, NOT Chase debits.
# Keep BANK_DETAILS_PRIVATE_KEY and INTEGRATION_TOKEN_KEY in protected recovery records.
# Never prefix these secrets with VITE_. Keep preview/development separate from production.
# CARD_PAYMENTS_DISABLED=true is a server-only checkout kill switch; never enable
# PAYMENTS_TEST_MODE in production. Test keys cannot open non-sandbox checkouts.

# Optional SMS collection and inbound processing are OFF unless explicitly enabled.
# SMS_CONSENT_COLLECTION_ENABLED=false
# SMS_TWILIO_INBOUND_ENABLED=false
# TWILIO_SMS_ACCOUNT_SID, TWILIO_SMS_AUTH_TOKEN: intended Twilio account, server-only.
# TWILIO_SMS_WEBHOOK_URL: exact HTTPS Convex site URL ending /sms/inbound.
# TWILIO_SMS_MESSAGING_SERVICE_SID: set only for the chosen Messaging Service.
# SMS_TWILIO_HELP_REPLY_ENABLED=false
# SMS_TWILIO_HELP_REPLY_TEXT: reviewed support reply; required before custom HELP replies.
# No outbound API client is used. Custom HELP reply TwiML requires a separate enable flag.
